{
    "name": "@degreesign/migrate",
    "version": "1.1.4",
    "description": "One-command Ubuntu/Debian server migration for Apache + PM2 + Node.js: streaming move of web files, SSL certificates, Apache config, PM2 apps and global npm packages over SSH.",
    "main": "migrate.sh",
    "bin": {
        "server-migration": "./migrate.sh"
    },
    "scripts": {
        "migrate": "chmod +x migrate.sh && ./migrate.sh"
    },
    "files": [
        "migrate.sh",
        ".env.example",
        "LICENSE",
        "README.md"
    ],
    "keywords": [
        "server migration",
        "server-migration",
        "migrate server",
        "apache2",
        "apache migration",
        "pm2",
        "pm2 migration",
        "nodejs",
        "nvm",
        "devops",
        "ubuntu",
        "debian",
        "ssh",
        "rsync",
        "letsencrypt",
        "ssl certificates",
        "cli"
    ],
    "author": "DegreeSign",
    "license": "Apache-2.0",
    "homepage": "https://github.com/DegreeSign/ds_migrate#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DegreeSign/ds_migrate.git"
    },
    "bugs": {
        "url": "https://github.com/DegreeSign/ds_migrate/issues"
    }
}